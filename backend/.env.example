# Levelbrook backend — env-var template.
# Copy this file to `backend/.env` and fill in the values, OR set the variables
# in your shell. Required vars are marked with `# REQUIRED` — without them the
# server panics on boot. Optional vars are marked `# OPTIONAL`.
#
# Loading: the binary reads from process env; use `set -a; source .env; set +a`,
# or `direnv` / `godotenv` / your runner of choice. The file is gitignored.

# ============================================================================
# Core
# ============================================================================

# `development` enables verbose logging, dev cookies, etc. Set `production`
# in deploy/api.env. # OPTIONAL — defaults to `development`.
APP_ENV=development

# Port the HTTP server binds to. # OPTIONAL — defaults to 8080.
PORT=8080

# Public base URL of the API. Used in emails, magic links, OAuth callbacks.
# Local dev: http://localhost:8080. Prod: https://api.levelbrook.com. # REQUIRED.
APP_BASE_URL=http://localhost:8080

# Public base URL of the frontend. Used to build redirect URLs and CORS origins.
# Local dev: http://localhost:5173. Prod: https://app.levelbrook.com. # REQUIRED.
FRONTEND_BASE_URL=http://localhost:5173

# slog level: debug | info | warn | error. # OPTIONAL — defaults to `info`.
LOG_LEVEL=info

# Cookie domain for session cookies (`ck_sess`). Use `localhost` in dev so the
# browser scopes the cookie to localhost; in prod use `levelbrook.com` so the
# cookie covers app.levelbrook.com + api.levelbrook.com. # OPTIONAL — default `localhost`.
SESSION_COOKIE_DOMAIN=localhost

# ============================================================================
# Database (SQLite, ADR-017)
# ============================================================================

# Path to the SQLite file. WAL + foreign_keys + busy_timeout pragmas applied
# automatically by db.Open. Migrations run on boot from backend/migrations/.
# Examples:
#   ./ck.db                              (relative — handy for dev)
#   file:/var/lib/compliancekit/ck.db    (production path on the droplet)
# # REQUIRED.
DATABASE_URL=./ck.db

# ============================================================================
# AWS — S3 (storage) + SES (email)
# ============================================================================

# IAM-scoped credentials for the `levelbrook-ses-sender` user. The same user
# also has `s3:PutObject`/`s3:GetObject` on the four buckets below. Rotate via
# `aws iam create-access-key` if compromised.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional override for local MinIO or LocalStack. Leave blank in prod. # OPTIONAL.
AWS_ENDPOINT_URL_S3=

# Four S3 buckets backing different document classes. All four must be set
# even in dev (they're declared `,required` in config.go) — but if you don't
# upload anything in dev they can be unused names. # ALL REQUIRED.
S3_BUCKET_DOCUMENTS=levelbrook-documents
S3_BUCKET_SIGNED_PDFS=levelbrook-signed-pdfs
S3_BUCKET_AUDIT_TRAIL=levelbrook-audit-trail
S3_BUCKET_RAW_UPLOADS=levelbrook-raw-uploads

# From-address for transactional email. Must be a verified SES identity (or in
# the SES sandbox the recipient must also be verified). # REQUIRED.
SES_FROM_EMAIL=no-reply@levelbrook.com

# ============================================================================
# Stripe — billing (REQ-002 / REQ-011)
# ============================================================================

# Test-mode keys start `sk_test_…` / `pk_test_…` / `whsec_…`.
# Live keys start `sk_live_…` and only go in deploy/api.env.

# Backend secret key. Used by the SDK in internal/billing/stripe.go. # REQUIRED.
STRIPE_SECRET_KEY=sk_test_replace_me

# Signing secret for the /webhooks/stripe endpoint. Stripe Dashboard →
# Developers → Webhooks → your endpoint → "Signing secret". # REQUIRED.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Default price id used when no annual/monthly variant is configured (legacy
# fallback for the Pro plan). # REQUIRED.
STRIPE_PRICE_PRO=price_replace_me

# REQ-002 plan variants. When set, the checkout flow uses these instead of
# STRIPE_PRICE_PRO. Annual is the default option on the pricing page; monthly
# is the secondary toggle. # OPTIONAL — fall back to STRIPE_PRICE_PRO if unset.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=

# ============================================================================
# Twilio — SMS (REQ-001 / REQ-007 / REQ-008 chase reminders)
# ============================================================================

# Trial accounts can only deliver to verified caller IDs. Buying any DID lifts
# the trial banner. The chain accepts EITHER `TWILIO_FROM_NUMBER` (a real DID
# you own) OR `TWILIO_MESSAGING_SERVICE_SID` (a Messaging Service that picks a
# DID for you). Set the SID if you don't own a DID yet. # ALL OPTIONAL — SMS
# is just disabled if creds are missing.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# ============================================================================
# OCR — Mistral (primary) + Gemini (fallback) (REQ-006)
# ============================================================================

# The chain in internal/ocr/ tries Mistral first; on rate-limit/empty-response
# it falls through to Gemini. Both are nice-to-have in dev — without them
# OCR returns "extraction unavailable" and the confirmation card shows the
# manual entry path. # BOTH OPTIONAL.
MISTRAL_API_KEY=
GEMINI_API_KEY=

# ============================================================================
# Magic-link signing (REQ-005 staff/parent upload portal)
# ============================================================================

# 32+ byte random hex/base64 string used as HMAC key for staff/parent upload
# tokens. Generate with: `openssl rand -hex 32`.
# Manager login is password-based (REQ-002/011); this signing key is now ONLY
# used for the staff/parent upload portal at /u/{token}. # REQUIRED.
MAGIC_LINK_SIGNING_KEY=replace-me-with-an-openssl-rand-hex-32-string

# ============================================================================
# Single-host / demo mode (all OPTIONAL, all off by default)
# ============================================================================
# Apply the embedded migrations on boot.
AUTO_MIGRATE=true
# Serve the built React app (frontend/dist) from this process.
# STATIC_DIR=../frontend/dist
# Use the local filesystem instead of S3 (presigned URLs become signed /blob/ URLs).
# STORAGE_LOCAL_DIR=./blobs
# Log email/SMS instead of sending them.
# OUTBOUND_DISABLED=true
# Seed a demo login and enable one-click sandboxes (POST /api/auth/demo).
# DEMO_MODE=true
# DEMO_ACCOUNT_EMAIL=demo@example.com
# DEMO_ACCOUNT_PASSWORD=inspection-ready
