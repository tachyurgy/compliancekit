# Environment for the single-container public demo (deploy/Dockerfile or the
# root Dockerfile). Copy to the host, fill MAGIC_LINK_SIGNING_KEY, chmod 600.
# Nothing here talks to a third party: storage is local disk, email and SMS
# are log-only, and Stripe keys are inert placeholders (checkout is hidden in
# the demo UI and never called).
APP_ENV=production
APP_BASE_URL=https://compliancekit.levelbrook.com
FRONTEND_BASE_URL=https://compliancekit.levelbrook.com
SESSION_COOKIE_DOMAIN=compliancekit.levelbrook.com
LOG_LEVEL=info

# 32+ random bytes: openssl rand -hex 32. Signs portal links and blob URLs.
MAGIC_LINK_SIGNING_KEY=

S3_BUCKET_DOCUMENTS=documents
S3_BUCKET_SIGNED_PDFS=signed-pdfs
S3_BUCKET_AUDIT_TRAIL=audit-trail
S3_BUCKET_RAW_UPLOADS=raw-uploads
SES_FROM_EMAIL=no-reply@example.com
STRIPE_SECRET_KEY=sk_test_disabled
STRIPE_WEBHOOK_SECRET=whsec_disabled
STRIPE_PRICE_PRO=price_disabled

OUTBOUND_DISABLED=true
DEMO_MODE=true
DEMO_ACCOUNT_EMAIL=demo@example.com
DEMO_ACCOUNT_PASSWORD=inspection-ready
