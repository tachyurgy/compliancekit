# Levelbrook frontend — env-var template.
# Copy this file to `frontend/.env` (local dev) or `frontend/.env.production`
# (build for app.levelbrook.com) and fill in the values.
#
# Vite reads anything prefixed `VITE_` at build/serve time and inlines it into
# the client bundle. NEVER put a secret here — these values ship to every
# browser that loads the app. Use only public/publishable keys.

# Backend API base URL.
#   Dev:  http://localhost:8080
#   Prod: https://api.levelbrook.com
VITE_API_BASE_URL=http://localhost:8080

# Stripe PUBLISHABLE key (pk_test_… in dev, pk_live_… in prod). Paired with
# the matching secret key in backend/.env (or deploy/api.env). Public —
# safe in the bundle.
# Stripe Dashboard → Developers → API keys → Publishable key.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Optional Sentry DSN for client error reporting. Public by design (DSN is
# scoped to write-only event ingestion). Leave blank to disable.
VITE_SENTRY_DSN=

# Vite base path. `/` for a custom domain (`app.levelbrook.com`). Use a
# subpath like `/repo-name/` only if hosting under a GitHub Pages project URL.
VITE_BASE_PATH=/
